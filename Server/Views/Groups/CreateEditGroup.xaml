<Window x:Class="Server.Views.CreateEditGroup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Server.Views"
        mc:Ignorable="d"
        Title="Group" Height="220" Width="415" ResizeMode="NoResize" FontFamily="Consolas">
    <Window.Resources >

        <Style TargetType="Button" x:Key="ModernButtonStyle">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#FF4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF388E3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <GroupBox Margin="10 10 0 0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="380" Grid.Column="0">
        <StackPanel>
            <UniformGrid Rows="3" Columns="2">
                <Label Margin="0 10 0 0" Content="Title:" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox Margin="0 10 0 0" x:Name="NameTextBox" Width="180" Height="20" HorizontalAlignment="Right" />

                <Label Content="Description:" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox  Margin="0 10 0 0" x:Name="DescriptionTextBox" Width="180" Height="20" HorizontalAlignment="Right" />

                <CheckBox x:Name="IsAdminGroupCheckBox" Margin="5 5 0 0" Content="Admin Group" IsChecked="False" />
            </UniformGrid>
           
            <WrapPanel HorizontalAlignment="Center" Margin="0 0 0 10">
                <Button Content="Cancel" Style="{StaticResource ModernButtonStyle}" Name="CancelButton" Click="CancelButton_Click" Width="100" Height="30" Margin="0 0 5 0" />
                <Button Content="Confirm" Style="{StaticResource ModernButtonStyle}" Name="Confirm" Click="Confirm_Click" Width="100" Height="30" Margin="5 0 0 0" />
            </WrapPanel>
        </StackPanel>
    </GroupBox>
</Window>
