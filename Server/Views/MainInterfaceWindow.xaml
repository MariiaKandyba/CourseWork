<Window x:Class="Server.Views.MainInterfaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Server.Views"
        mc:Ignorable="d"
        Title="MainInterfaceWindow" Height="650" Width="1050" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="DataGrid" x:Key="ModernDataGridStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
            <Setter Property="RowBackground" Value="#FFEFEFEF"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalGridLinesBrush" Value="#FFCDCDCD"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FFCDCDCD"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style TargetType="DataGridColumnHeader" x:Key="ModernDataGridColumnHeaderStyle">
            <Setter Property="Background" Value="#FFB4B4B4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF9F9F9F"/>
            <Setter Property="BorderThickness" Value="0,0,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow" x:Key="ModernDataGridRowStyle">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="#FFE3EFFF"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#FFB9B9B9"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>



    </Window.Resources>
    <Grid>
        <TabControl x:Name="a" Background="White">
            <TabItem x:Name="usersTab" >
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="3">Users</TextBlock>
                    </StackPanel>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ToolBar Background="White" >
                            <Button Name="CreateTestButton" Command="{Binding AddUserCommand}" CommandParameter="{Binding}">
                                <StackPanel >
                                    <Image Source="/Resources/add-user_color.png" Width="30" Height="30"  />
                                    <Label Content="Add User" ></Label>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding EditUserCommand}" CommandParameter="{Binding}">
                                <StackPanel  >
                                    <Image Source="/Resources/edit_color.png" Width="30" Height="30" />
                                    <Label Content="Edit User" ></Label>
                                </StackPanel>
                            </Button>
                            <Button Name="OpenButton" Command="{Binding DeleteUserCommand}" CommandParameter="{Binding}">
                                <StackPanel >
                                    <Image Source="/Resources/delete_color.png" Width="30" Height="30" />
                                    <Label Content="Delete User" ></Label>
                                </StackPanel>
                            </Button>
                            <Button Name="RestoreButton" Command="{Binding RestoreUserCommand}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <Image Source="/Resources/restore.png" Width="30" Height="30" />
                                    <Label Content="Restore User" ></Label>
                                </StackPanel>
                            </Button>
                            <Button 
                                Name="usertestButton" 
                                Margin="550 0 0 0"
                                Command="{Binding SeeResultsCommand}" 
                                CommandParameter="{Binding}">
                                <StackPanel>
                                    <Image Source="/Resources/test.png" Width="30" Height="30" />
                                    <Label Content="See Results"></Label>
                                </StackPanel>
                            </Button>
                            <Button Name="updateButton" Command="{Binding UpdateCommand}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <Image Source="/Resources/update.png" Width="30" Height="30"/>
                                    <Label Content="Update Data" ></Label>
                                </StackPanel>
                            </Button>
                           
                        </ToolBar>
                        <ScrollViewer 
                        VerticalScrollBarVisibility="Auto"
                        Grid.Row="1" Grid.ColumnSpan="2" >
                            <DataGrid 
                            VerticalAlignment="Top"
                            ItemsSource="{Binding Users}" 
                            Style="{StaticResource ModernDataGridStyle}" 
                            ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}" 
                            RowStyle="{StaticResource ModernDataGridRowStyle}"
                            AutoGenerateColumns="False"
                            SelectedItem="{Binding SelectedUser}"
                            MaxHeight="400" IsReadOnly="True" >
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Full name" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                <Run Text="{Binding FirstName}"/>
                                                <Run Text="{Binding LastName}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Username" Binding="{Binding Login}" Width="*"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTemplateColumn Header="Admin" Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox 
                                                HorizontalAlignment="Center"
                                                IsChecked="{Binding IsAdmin}" 
                                                IsEnabled="False"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Register Date" Binding="{Binding RegisterDate, StringFormat=d MMMM yyyy}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </Grid>
                </TabItem.Content>
            </TabItem>
            <TabItem x:Name="groupsTab" >
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="3">Groups</TextBlock>
                    </StackPanel>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ToolBar Background="White" >
                            <Button Name="groupButton" Command="{Binding AddGroupCommand}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <Image Source="/Resources/add-group-color.png" Width="30" Height="30" />
                                    <Label Content="Add group"></Label>

                                </StackPanel>
                            </Button>
                            <Button Command="{Binding EditGroupCommand}" CommandParameter="{Binding}">

                                <StackPanel>
                                    <Image Source="/Resources/edit_color.png" Width="30" Height="30" />
                                    <Label Content="Edit Group"></Label>

                                </StackPanel>
                            </Button>
                            <Button Name="editButton" Command="{Binding DeleteGroupCommand}" CommandParameter="{Binding}">

                                <StackPanel >

                                    <Image Source="/Resources/delete_color.png" Width="30" Height="30" />
                                    <Label Content="Delete Group"></Label>

                                </StackPanel>
                            </Button>
                            <Button Name="addtoGroupButton" Margin="20 0 0 0" Command="{Binding AddUserToGroupCommand}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <Image Source="/Resources/assign.png" Width="30" Height="30"/>
                                    <Label Content="Manage groups" ></Label>

                                </StackPanel>
                            </Button>
                            <Button Name="updategroupButton" Command="{Binding UpdateGroupCommand}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <Image Source="/Resources/update.png" Width="30" Height="30" />
                                    <Label Content="Update Data" ></Label>
                                </StackPanel>
                            </Button>
                        </ToolBar>
                        <ScrollViewer 
                        VerticalScrollBarVisibility="Auto"
                        Grid.Row="1" >
                            <DataGrid 
                            VerticalAlignment="Top"
                            ItemsSource="{Binding Groups}" 
                            Style="{StaticResource ModernDataGridStyle}" 
                            ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}" 
                            RowStyle="{StaticResource ModernDataGridRowStyle}"
                            AutoGenerateColumns="False"
                            SelectedItem="{Binding SelectedGroup}"
                            MaxHeight="400" IsReadOnly="True" >
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTemplateColumn Header="Admin" Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox 
                                                HorizontalAlignment="Center"
                                                IsChecked="{Binding IsAdminGroup}" 
                                                IsEnabled="False"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>

                    </Grid>
                </TabItem.Content>
            </TabItem>


            <TabItem x:Name="assignedTestTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="3">Assign</TextBlock>
                    </StackPanel>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ToolBar Background="White">
                            <Button Name="assignToOneButton" Command="{Binding AssignToUsersCommand}" CommandParameter="{Binding}">
                                <StackPanel >
                                    <Image Source="/Resources/assign.png" Width="30" Height="30" />
                                    <Label Content="Assign User"  />

                                </StackPanel>
                            </Button>
                            <Button Name="assignToGrounButton" Command="{Binding AssignToGroupCommand}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <Image Source="/Resources/delegation.png" 
                                           Width="30" Height="30" 
                                           Margin="15 0 0 0 " />
                                    <Label Content="Assign Group"  />
                                </StackPanel>
                            </Button>
                            <Button Name="ConfirmAssignmentButton" Margin="30 0 0 0" Command="{Binding ConfirmAssignmentCommand}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <Image Source="/Resources/approve.png" Width="30" Height="30" />
                                    <Label Content="Confirm Assigment"  />
                                </StackPanel>
                            </Button>

                            <Button Name="AssignedBtn" Command="{Binding InfoAssignmentCommand}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <Image Source="/Resources/information.png"  Width="30" Height="30" />
                                    <Label Content="Assigned Members" />
                                </StackPanel>
                            </Button>
                            <Button Name="UploadTestBtn"  Margin="110 0 0 0 " Command="{Binding UploadTestCommand}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <Image Source="/Resources/submit.png"  Width="30" Height="30" />
                                    <Label Content="Upload Test"/>
                                </StackPanel>
                            </Button>
                            <Button Name="PreviewTestBtn" Command="{Binding PreviewTestCommand}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <Image Source="/Resources/preview.png"  Width="30" Height="30" />
                                    <Label Content="Preview Test"/>
                                </StackPanel>
                            </Button>
                            <Button Name="DeleteTestBtn" Command="{Binding DeleteTestCommand}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <Image Source="/Resources/delete_color.png"  Width="30" Height="30" />
                                    <Label Content="Delete Test"/>
                                </StackPanel>
                            </Button>

                            <Button Name="RestoreTestBtn" Command="{Binding RestoreTestCommand}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <Image Source="/Resources/restore.png"  Width="30" Height="30" />
                                    <Label Content="Restore Test"/>
                                </StackPanel>
                            </Button>

                            <Button Margin="45 0 0 0" Name="UpdateTestBtn" Command="{Binding UpdateTestCommand}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <Image Source="/Resources/update.png"  Width="30" Height="30" />
                                    <Label Content="Update Data"/>
                                </StackPanel>
                            </Button>


                        </ToolBar>
                        <ScrollViewer 
                        VerticalScrollBarVisibility="Auto" 
                        Grid.Row="1">
                            <DataGrid  ItemsSource="{Binding Tests}"  
                                   SelectedItem="{Binding SelectedTest}"
                                   VerticalAlignment="Top"
                                    Style="{StaticResource ModernDataGridStyle}" 
                                    ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}" 
                                    RowStyle="{StaticResource ModernDataGridRowStyle}"
                                    AutoGenerateColumns="False"
                                    IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Title}" Width="*"/>
                                    <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="*"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTextColumn Header="Pass Percent" Binding="{Binding PassPercent, StringFormat={}{0}%}" Width="85" />
                                    <DataGridTextColumn Header="Loaded Date" Binding="{Binding LoadedDate, StringFormat=d MMMM yyyy}" Width="*"/>
                                </DataGrid.Columns>

                            </DataGrid>
                        </ScrollViewer>


                        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="2" Visibility="{Binding GroupsVisibility}">
                            <ScrollViewer 
                         VerticalScrollBarVisibility="Auto"
                         Grid.Row="1" >
                                <DataGrid 
                             VerticalAlignment="Top"
                             ItemsSource="{Binding Groups}" 
                             Style="{StaticResource ModernDataGridStyle}" 
                             ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}" 
                             RowStyle="{StaticResource ModernDataGridRowStyle}"
                             AutoGenerateColumns="False"
                             SelectedItem="{Binding SelectedGroup}"
                             MaxHeight="400" IsReadOnly="True" >
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                        <DataGridTemplateColumn Header="Admin" Width="50">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox 
                                                 HorizontalAlignment="Center"
                                                 IsChecked="{Binding IsAdminGroup}" 
                                                 IsEnabled="False"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                    </DataGrid.Columns>
                                </DataGrid>
                            </ScrollViewer>
                        </ScrollViewer>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="2" Visibility="{Binding UsersVisibility}">
                            <ScrollViewer 
                        VerticalScrollBarVisibility="Auto"
                        Grid.Row="1" >
                                <DataGrid 
                            VerticalAlignment="Top"
                            ItemsSource="{Binding Users}" 
                            Style="{StaticResource ModernDataGridStyle}" 
                            ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}" 
                            RowStyle="{StaticResource ModernDataGridRowStyle}"
                            AutoGenerateColumns="False"
                            SelectedItem="{Binding SelectedUser}"
                             IsReadOnly="True" >
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Full name" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                    <Run Text="{Binding FirstName}"/>
                                                    <Run Text="{Binding LastName}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Username" Binding="{Binding Login}" Width="*"/>
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                        <DataGridTemplateColumn Header="Admin" Width="50">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox 
                                                HorizontalAlignment="Center"
                                                IsChecked="{Binding IsAdmin}" 
                                                IsEnabled="False"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Register Date" Binding="{Binding RegisterDate}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ScrollViewer>
                        </ScrollViewer>
                    </Grid>
                </TabItem.Content>
            </TabItem>




            <TabItem x:Name="serversTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="3">Server</TextBlock>
                    </StackPanel>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ToolBar Background="White">
                            <Button Name="startServerButton" Command="{Binding StartServerCommand}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <Image Source="/Resources/start.png" Width="50" Height="40" />
                                    <Label Content="Start Server" FontSize="10"></Label>

                                </StackPanel>
                            </Button>
                            <Button Name="stopServerButton" Command="{Binding StopServerCommand}" CommandParameter="{Binding}">
                                <StackPanel  >
                                    <Image Source="/Resources/stop.png"  Width="30" Height="40"/>
                                    <Label Content="Stop Server" FontSize="10"></Label>

                                </StackPanel>
                            </Button>
                            <Button Name="logout" Click="logout_Click" Margin="750 0 0 0 ">
                                <StackPanel >
                                    <Image Source="/Resources/logout.png" Width="30" Height="40"  />
                                    <Label Content="Log out" FontSize="10"></Label>
                                </StackPanel>
                            </Button>





                        </ToolBar>

                        <ListBox 
                            Background="White" 
                            Name="ConnectedClientsListBox" 
                            Grid.Row="1 " 
                            FontSize="20"
                            ItemsSource="{Binding ConnectedClients}">

                        </ListBox>


                    </Grid>
                </TabItem.Content>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
