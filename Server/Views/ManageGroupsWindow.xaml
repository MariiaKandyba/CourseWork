<Window x:Class="Server.Views.ManageGroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Server.Views"
        mc:Ignorable="d"
        Title="ManageGroupsWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <ToolBar Background="White" >
            
        <Button Name="groupButton" Width="50" Height="50" Click="groupButton_Click" Background="White" VerticalAlignment="Top" HorizontalAlignment="Left" BorderBrush="White">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Resources/diskette.png" Width="25" Height="25" />
            </StackPanel>
        </Button>
        <Button Name="addButton" Click="addButton_Click" Width="50" Height="50" Background="White" Margin="100 0 0 0" VerticalAlignment="Top" HorizontalAlignment="Left" BorderBrush="White">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Resources/plus.png" Width="25" Height="25" />
            </StackPanel>
        </Button> <Button Name="removeButton" Click="removeButton_Click" Width="50" Height="50" Background="White" VerticalAlignment="Top" HorizontalAlignment="Left" BorderBrush="White">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Resources/minus-sign.png" Width="25" Height="25" />
            </StackPanel>
        </Button>
        </ToolBar>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
            <DataGrid x:Name="inGroup"
            VerticalAlignment="Top"
            AutoGenerateColumns="False"
            MaxHeight="200" IsReadOnly="True" >     
                <DataGrid.Columns>
                    <DataGridTextColumn Header="First name" Binding="{Binding FirstName}" Width="*"/>
                    <DataGridTextColumn Header="Last name" Binding="{Binding LastName}" Width="*"/>
                    <DataGridTextColumn Header="Username" Binding="{Binding Login}" Width="*"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Admin" Binding="{Binding IsAdmin}" Width="*"/>
                    <DataGridTextColumn Header="Register Date" Binding="{Binding RegisterDate}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="2" >
            <DataGrid x:Name="others" 
    VerticalAlignment="Top"
    AutoGenerateColumns="False"
    MaxHeight="250" IsReadOnly="True" >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="First name" Binding="{Binding FirstName}" Width="*"/>
                    <DataGridTextColumn Header="Last name" Binding="{Binding LastName}" Width="*"/>
                    <DataGridTextColumn Header="Username" Binding="{Binding Login}" Width="*"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Admin" Binding="{Binding IsAdmin}" Width="*"/>
                    <DataGridTextColumn Header="Register Date" Binding="{Binding RegisterDate}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>
    </Grid>
</Window>
