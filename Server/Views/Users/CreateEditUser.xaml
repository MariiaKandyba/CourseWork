<Window x:Class="Server.Views.CreateEditUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Server.Views"
        mc:Ignorable="d"
        Title="User" Height="370" Width="415" ResizeMode="NoResize" FontFamily="Consolas">
    <Window.Resources>

        <Style TargetType="Button" x:Key="ModernButtonStyle">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#FF4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF388E3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
    </Window.Resources>

    <GroupBox 
        Header="" 
        Margin="10 20 0 0" 
        HorizontalAlignment="Left" 
        VerticalAlignment="Top" 
        Width="380" Grid.Column="0">
        <StackPanel>
            <UniformGrid Rows="5" Columns="2" >
                <Label Margin="0 10 0 0 " Content="First Name*:" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox  x:Name="FirstNameTextBox" Width="180" Height="20" HorizontalAlignment="Right"/>

                <Label Content="Last Name*:" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox x:Name="LastNameTextBox" Width="180" Height="20" HorizontalAlignment="Right" />

                <Label Content="Description:" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox x:Name="DescriptionTextBox" Width="180" Height="20" HorizontalAlignment="Right" />
                <Label Content="Login*:" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox x:Name="LoginTextBox" Width="180" Height="20" HorizontalAlignment="Right" />
                <Label Content="Password*:" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <PasswordBox x:Name="PasswordBox" Width="180" Height="20" HorizontalAlignment="Right" PasswordChar="*" />
                <TextBox x:Name="PasswordTextBox" Width="180" Height="20" HorizontalAlignment="Right" Visibility="Collapsed" />
            </UniformGrid>
            <WrapPanel Margin="0 10 0 0 ">
                <CheckBox x:Name="AdminCheckBox" Margin="5 5 0 0" Content="Admin" 
                          IsChecked="False" />
                <CheckBox x:Name="ShowPasswordCheckBox"  Margin="127 5 0 0" Content="Show Password" HorizontalAlignment="Right" Checked="ShowPasswordCheckBox_Checked" Unchecked="ShowPasswordCheckBox_Unchecked" />
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Center" Margin="25">
                <Button Style="{StaticResource ModernButtonStyle}" Content="Cancel"  Name="CancelButton" Click="CancelButton_Click"/>
                <Button Style="{StaticResource ModernButtonStyle}" Content="Confirm"  Name="Confirm" Click="Confirm_Click"/>
            </WrapPanel>
        </StackPanel>
    </GroupBox>
</Window>

