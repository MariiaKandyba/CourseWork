<Window x:Class="Server.Views.Users.RestoreUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Server.Views.Users"
        mc:Ignorable="d"
        Title="RestoreUserWindow" Height="450" Width="800">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ToolBar Background="White" >
                <Button Name="RestoreButton" Click="RestoreButton_Click">
                    <StackPanel>
                        <Image Source="/Resources/restore.png" Width="25" Height="25" />
                        <Label Content="Restore User" FontSize="8"></Label>
                    </StackPanel>
                </Button>
            </ToolBar>
            <ScrollViewer 
        VerticalScrollBarVisibility="Auto"
        Grid.Row="1" Grid.ColumnSpan="2" >
                <DataGrid 
                    x:Name="grid"
            VerticalAlignment="Top"
            ItemsSource="{Binding Users}" 
            Style="{StaticResource ModernDataGridStyle}" 
            ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeaderStyle}" 
            RowStyle="{StaticResource ModernDataGridRowStyle}"
            AutoGenerateColumns="False"
            SelectedItem="{Binding SelectedUser}"
                    SelectionMode="Extended"
            MaxHeight="400" IsReadOnly="True" >
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Full name" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                <Run Text="{Binding FirstName}"/>
                                <Run Text="{Binding LastName}" />
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Username" Binding="{Binding Login}" Width="*"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        <DataGridTemplateColumn Header="Admin" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox 
                                HorizontalAlignment="Center"
                                IsChecked="{Binding IsAdmin}" 
                                IsEnabled="False"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Register Date" Binding="{Binding RegisterDate, StringFormat=d MMMM yyy}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>

        </Grid>
</Window>
