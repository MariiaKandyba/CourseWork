<Window x:Class="Server.Views.CreateEditUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Server.Views"
        mc:Ignorable="d"
        Title="CreateEditUser" Height="450" Width="800">
    <GroupBox Header="User Information" Margin="0 50 0 0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="380" Grid.Column="0">
        <StackPanel>
            <UniformGrid Rows="5" Columns="2">
                <Label Content="First Name:" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox x:Name="FirstNameTextBox" Width="180" Height="20" HorizontalAlignment="Right"/>

                <Label Content="Last Name:" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox x:Name="LastNameTextBox" Width="180" Height="20" HorizontalAlignment="Right" />

               


                <Label Content="Description:" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox x:Name="DescriptionTextBox" Width="180" Height="20" HorizontalAlignment="Right" />
                <Label Content="Login:" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox x:Name="LoginTextBox" Width="180" Height="20" HorizontalAlignment="Right" />
                <Label Content="Password:" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <PasswordBox x:Name="PasswordBox" Width="180" Height="20" HorizontalAlignment="Right" PasswordChar="*" />
                <TextBox x:Name="PasswordTextBox" Width="180" Height="20" HorizontalAlignment="Right" Visibility="Collapsed" />
            </UniformGrid>
                <CheckBox x:Name="ShowPasswordCheckBox" Margin="5 5 0 0" Content="Show Password" HorizontalAlignment="Right" Checked="ShowPasswordCheckBox_Checked" Unchecked="ShowPasswordCheckBox_Unchecked" />

                <CheckBox x:Name="AdminCheckBox" Margin="5 5 0 0" Content="Admin" IsChecked="False" />

            <WrapPanel HorizontalAlignment="Center">
                <Button Content="Cancel"  Name="CancelButton" Click="CancelButton_Click" Width="100" Height="20" Margin="0 20 5 0" />
                <Button Content="Confirm"  Name="Confirm" Click="Confirm_Click" Width="100" Height="20" Margin="5 20 0 0" />

            </WrapPanel>
        </StackPanel>
    </GroupBox>
</Window>
