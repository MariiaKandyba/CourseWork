<Window x:Class="Server.Views.CreateEditGroup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Server.Views"
        mc:Ignorable="d"
        Title="CreateEditGroup" Height="350" Width="500">
    <GroupBox Header="Group Information" Margin="0 50 0 0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="380" Grid.Column="0">
        <StackPanel>
            <UniformGrid Rows="3" Columns="2">
                <Label Content="Name:" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox x:Name="NameTextBox" Width="180" Height="20" HorizontalAlignment="Right" />

                <Label Content="Description:" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBox x:Name="DescriptionTextBox" Width="180" Height="20" HorizontalAlignment="Right" />

                <CheckBox x:Name="IsAdminGroupCheckBox" Margin="5 5 0 0" Content="Admin Group" IsChecked="False" />
            </UniformGrid>

            <WrapPanel HorizontalAlignment="Center">
                <Button Content="Cancel" Name="CancelButton" Click="CancelButton_Click" Width="100" Height="20" Margin="0 20 5 0" />
                <Button Content="Confirm" Name="Confirm" Click="Confirm_Click" Width="100" Height="20" Margin="5 20 0 0" />
            </WrapPanel>
        </StackPanel>
    </GroupBox>
</Window>
