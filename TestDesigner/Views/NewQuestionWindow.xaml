<Window x:Class="TestDesigner.Views.NewQuestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestDesigner.Views"
        mc:Ignorable="d" Title="New Question" Height="500" Width="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="10">
            <TextBlock Text="New Question" FontSize="18" FontWeight="Bold" />

            <Label Content="Question Text:" />
            <TextBox Width="300" Height="50" Name="TextTB"/>

            <Label Content="Points:" />
            <TextBox Width="200" Name="PointsTB"  />

            <WrapPanel HorizontalAlignment="Center">
            <Button Content="Cancel"  Name="CancelButton" Click="CancelButton_Click" Width="100" Height="20" Margin="0 20 5 0" />
            <Button Content="Add Question"  Name="AddButton" Click="AddButton_Click" Width="100" Height="20" Margin="5 20 0 0" />
            <Button Content="Add Image"   Name="AddimageButton" Click="AddimageButton_Click" Width="100" Height="20" Margin="5 20 0 0" />
                
            </WrapPanel>
            <Image x:Name="imgPreview" 
                   Width="310"
                   Height="220"
                   
                   Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" 
                   Margin="10,40,0,0"  />
        </StackPanel>
        <StackPanel Grid.Column="1" Width="300">
                <ToolBar Width="Auto">
                <Button Name="AddAnswerButton" Click="AddAnswerButton_Click" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/TestDesigner;component/Resources/plus.png" Width="50" Height="25" />
                        </StackPanel>
                    </Button>
                    <Button Name="EditBTN" Click="EditBTN_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/TestDesigner;component/Resources/pencil.png" Width="50" Height="30" />
                        </StackPanel>
                    </Button>
                    <Button Name="DeleteBTN" Click="DeleteBTN_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/TestDesigner;component/Resources/delete.png" Width="50" Height="30" />
                        </StackPanel>
                    </Button>
                </ToolBar>
                <DataGrid Name="AnswersDataGrid" Height="420" AutoGenerateColumns="False" 
          ItemsSource="{Binding Answers}" DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Answer" Binding="{Binding TextAnswer}" Width="*" />
                    <DataGridTextColumn Header="Is True" Binding="{Binding IsRight}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Window>
