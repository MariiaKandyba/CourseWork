<Window x:Class="TestDesigner.Views.AddAnswerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestDesigner.Views"
        mc:Ignorable="d"
        Title="AddAnswerWindow" Height="250" Width="300">
    <StackPanel Margin="0 20 0 0">
        <Label Content="Add Answer:" />

        <TextBox Name="AnswerTextBox" Width="200" Height="30" Margin=" 0 0 0 20" />

        <CheckBox Name="IsTrueCheckBox" Content="Is True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <WrapPanel HorizontalAlignment="Center" Margin="0 20 0 0">
            
        <Button Content="Cancel" Width="100" Height="30" Margin="0 0 20 0"  />
        <Button Name="SaveBTN" Content="Save" Width="100" Height="30" Click="SaveBTN_Click"  />
        </WrapPanel> 

    </StackPanel>
</Window>
