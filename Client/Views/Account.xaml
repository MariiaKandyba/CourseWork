<Window x:Class="Client.Views.Account"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client.Views"
        mc:Ignorable="d"
        Title="Account" Height="450" Width="800">
    <Grid>
        <TabControl x:Name="a" Grid.ColumnSpan="2" >
            <TabItem x:Name="myInfoTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="3">Personal Info</TextBlock>
                    </StackPanel>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="150"/>
                        </Grid.RowDefinitions>
                        <Label Name="infoLbl" Grid.Row="1"></Label>
                        <ToolBar Background="White">
                            <Button Click="Button_Click" CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Resources/logout.png" Width="61" Height="40" />
                                </StackPanel>
                            </Button>
                            <Label Content="{Binding ServerState}"></Label>

                        </ToolBar>
                        
                    </Grid>
                </TabItem.Content>
            </TabItem>
            <TabItem x:Name="assignedTestTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="3">Assigned</TextBlock>
                    </StackPanel>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="150"/>
                        </Grid.RowDefinitions>
                        <ToolBar Background="White">
                            <Button Name="CreateTestButton" Command="{Binding StartTestCommand}" CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Resources/start.png" Width="61" Height="40" />
                                </StackPanel>
                            </Button>
                            <Label Content="{Binding ServerState}"></Label>

                        </ToolBar>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
                            <DataGrid  ItemsSource="{Binding Tests}"  SelectedItem="{Binding SelectedTest}"  VerticalAlignment="Top"
 AutoGenerateColumns="False"
 MaxHeight="250" IsReadOnly="True" >
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Title}" Width="*"/>
                                    <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="*"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTextColumn Header="Info" Binding="{Binding Info}" Width="*"/>
                                    <DataGridTextColumn Header="Pass Percent" Binding="{Binding PassPercent}" Width="*"/>
                                    <DataGridTextColumn Header="Loaded Date" Binding="{Binding LoadedDate}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </Grid>
                </TabItem.Content>
            </TabItem>
         <TabItem x:Name="HistoryTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="3">History</TextBlock>
                    </StackPanel>
                </TabItem.Header>
                <TabItem.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="150"/>
                            <!--<RowDefinition Height="150"/>-->
                        </Grid.RowDefinitions>
                        <ToolBar Background="White">
                            <Button Name="TestInfoButton" Command="{Binding GetInfoCommand}" CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Resources/information.png" Width="50" Height="30" />
                                </StackPanel>
                            </Button>
                            
                        </ToolBar>
                        
                     <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
                            <DataGrid  ItemsSource="{Binding Tests}"  SelectedItem="{Binding SelectedTest}"  VerticalAlignment="Top"
 AutoGenerateColumns="False"
 MaxHeight="250" IsReadOnly="True" >
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Title}" Width="*"/>
                                    <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="*"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTextColumn Header="Info" Binding="{Binding Info}" Width="*"/>
                                    <DataGridTextColumn Header="Pass Percent" Binding="{Binding PassPercent}" Width="*"/>
                                    <DataGridTextColumn Header="Loaded Date" Binding="{Binding LoadedDate}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </Grid>
                </TabItem.Content>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
